# Existing optional legacy/offline research tools
ANTHROPIC_API_KEY=
BROWSERBASE_API_KEY=

# Live talking-point generation (face lookup + research happen elsewhere)
TALKING_POINTS_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash-lite
# For a keyless local pipeline test instead:
# TALKING_POINTS_PROVIDER=dummy

# Comma-separated, case-insensitive whole phrases
CONVERSATION_START_PHRASES=start conversation
CONVERSATION_END_PHRASES=bye,goodbye,see you later,end conversation
TALKING_POINT_REFRESH_SECONDS=4
TALKING_POINT_TRANSCRIPT_CHARS=16000
